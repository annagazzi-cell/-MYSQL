('Marrone');
select*from medico;

create table if not exists consulta (
	id int primary key auto_increment,
    data_time datetime,
    id_paciente int,
    id_medico int,
    foreign key (id_paciente) references paciente(id),
    foreign key (id_medico) references medico(id)
) character set utf8mb4;
-- Atividade 03: Cadastrar (código completo) igual exemplo
insert into consulta
(data_time, id_paciente, id_medico)
values
('2026-09-15 11:11', 1, 2),
('2026-09-15 11:18', 4, 1),
('2026-09-15 11:20', 7, 3),
('2026-09-15 11:21', 4, 2),
('2026-09-15 11:30', 5, 1);
select*from consulta;
select consulta.id, consulta.data_time, paciente.nome, medico.nome
from consulta
inner join paciente on consulta.id_paciente = paciente.id
inner join medico on consulta.id_medico = medico.id;

